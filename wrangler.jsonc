{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bdd-duck-tape",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "XRAY_BASE_URL": "https://xray.cloud.getxray.app"
  }
}
